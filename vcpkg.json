{
  "name": "sqsgenerator",
  "version-string": "0.5.6",
  "dependencies": [
    "glaze",
    "eigen3",
    "unordered-dense",
    "boost-multiprecision"
  ],
  "features": {
    "native": {
      "description": "Native command line tools for SQS generator",
      "dependencies": [
        "abseil"
      ]
    },
    "python": {
      "description": "Python bindings for SQS generator",
      "dependencies": [
        "eigen3",
        "boost-multiprecision",
        "nlohmann-json",
        "bshoshany-thread-pool",
        {
          "name": "abseil",
          "platform": "!windows"
        }
      ]
    },
    "tests": {
      "description": "Unit tests for SQS generator",
      "dependencies": [
        "catch2"
      ]
    },
    "wasm": {
      "description": "WebAssembly support for SQS generator",
      "dependencies": [
        "abseil"
      ]
    },
    "mpi": {
      "description": "Distributed (MPI) support for SQS generator"
    }
  }
}
